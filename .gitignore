# Secrets (.env.example files stay tracked)
.env
.env*.local
*.pem
*.key
*.p8
*.p12
*.jks
*.mobileprovision

# Python (backend/)
backend/.venv/
__pycache__/
.pytest_cache/
backend/traces/

# Node / Expo (mobile/)
node_modules/
.expo/
dist/
web-build/
expo-env.d.ts
*.tsbuildinfo
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*

# Native projects are generated by `expo run:ios` / `expo prebuild`; never edit them
mobile/ios/
mobile/android/
.kotlin/
*.orig.*

# Claude Code: shared settings.json stays tracked; personal overrides don't
.claude/settings.local.json

.DS_Store
